# Supabase/PostgreSQL connection used by SQLAlchemy and LangGraph checkpoints.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Groq generation models.
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=

# Comma-separated frontend origins. Set this to the final Vercel URL on Railway.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep ONNX Runtime conservative on Railway's 512 MB instance.
FASTEMBED_THREADS=1
